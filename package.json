{
  "name": "task-management-dashboard",
  "version": "1.0.0",
  "description": "A comprehensive task management dashboard for testing agentic capabilities",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "npm run build:frontend",
    "build:frontend": "webpack --mode production",
    "dev:frontend": "webpack --mode development --watch",
    "setup": "npm install && npm run init:db",
    "init:db": "node server/scripts/init-db.js"
  },
  "keywords": ["task-management", "dashboard", "agentic-testing", "web-app"],
  "author": "Copilot Agent",
  "license": "Apache-2.0",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.2",
    "axios": "^1.5.0",
    "dotenv": "^16.3.1",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "html-webpack-plugin": "^5.5.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}